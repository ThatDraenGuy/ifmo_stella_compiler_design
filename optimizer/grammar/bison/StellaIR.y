    return 0;
  }
  YY_BUFFER_STATE buf = stella_ir__scan_string(str, scanner);
  int error = yyparse(scanner, &result);
  stella_ir__delete_buffer(buf, scanner);
  stella_ir_lex_destroy(scanner);
  if (error)
  { /* Failure */
    return 0;
  }
  else
  { /* Success */
    return result.unit_;
  }
}

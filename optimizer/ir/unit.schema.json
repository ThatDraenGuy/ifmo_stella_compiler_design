        "incoming": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pred": {
                "$ref": "#/$defs/identifier"
              },
              "value": {
                "$ref": "#/$defs/operand"
              }
            },
            "required": [
              "pred",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "op",
        "results",
        "incoming"
      ],
      "additionalProperties": false
    },
    "ssaInstruction": {
      "oneOf": [

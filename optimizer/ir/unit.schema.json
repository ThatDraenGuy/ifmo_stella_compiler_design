        },
        "then": {
          "$ref": "#/$defs/identifier"
        },
        "else": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "op",
        "args",
        "then",
        "else"
      ],
      "additionalProperties": false
    },
    "return": {
      "type": "object",
      "properties": {
        "op": {

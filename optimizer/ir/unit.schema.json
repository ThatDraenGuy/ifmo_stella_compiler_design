{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stella IR unit, format version 1",
  "$comment": "Structural schema from Stella IR v1. See README.md for the student contract and attribution. The supplied verifier also checks names, types, graph structure, dominance, and scope.",
  "oneOf": [
    {
      "$ref": "#/$defs/cfgUnit"
    },
    {
      "$ref": "#/$defs/ssaUnit"
    },
    {
      "$ref": "#/$defs/functionalUnit"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "type": {
      "enum": [
        "i64",
        "bool",
        "ref"
      ]
    },
    "unsigned": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "integer": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])"
    },
    "error": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "binding": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "$ref": "#/$defs/type"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "var": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "var"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "i64": {
              "$ref": "#/$defs/integer"
            }
          },
          "required": [
            "i64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": [
            "bool"
          ],
          "additionalProperties": false
        }
      ]
    },
    "static": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/static"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/static"
          }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/static"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "capacity": {
          "$ref": "#/$defs/unsigned"
        },
        "entry": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "fields",
        "capacity",
        "entry",
        "updatable"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "saved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "result": {
          "$ref": "#/$defs/type"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "name",
        "saved",
        "result",
        "target"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "copy",
            "add",
            "sub",
            "mul",
            "div",
            "rem",
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "not",
            "and",
            "or",
            "xor"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "op",
        "args",
        "results"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "op": {
          "const": "call"
        },
        "callee": {
          "$ref": "#/$defs/identifier"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "op",
        "callee",
        "args",
        "results"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "op": {
          "const": "run"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "op",
        "target",
        "args",
        "results"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "op": {
          "const": "runtime"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "attributes": {
          "$ref": "#/$defs/attributes"
        }
      },
      "required": [
        "op",
        "name",
        "args",
        "results",
        "attributes"
      ],
      "additionalProperties": false
    },
    "instruction": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/call"
        },
        {
          "$ref": "#/$defs/run"
        },
        {
          "$ref": "#/$defs/runtime"
        }
      ]
    },
    "phi": {
      "type": "object",
      "properties": {
        "op": {
          "const": "phi"
        },
        "results": {

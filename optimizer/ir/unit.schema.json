        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    "tail": {
      "type": "object",
